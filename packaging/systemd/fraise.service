# Fraise systemd user unit. Install it to /usr/lib/systemd/user/, where the
# .deb and .rpm packages ship it. Then, per user:
#
#   systemctl --user enable --now fraise
#   journalctl --user -u fraise -f
#
# When agents run long, the service must survive the user logging out:
#   loginctl enable-linger $USER
#
# For a system-level install (a shared server instance):
#   - Copy this unit to /etc/systemd/system/fraise.service.
#   - Replace %h with a real home, or point -config at
#     /etc/fraise/fraise.config.toml.
#   - Add User=fraise to [Service].
# See https://docs.getfraise.dev/docs/operations/managed-service.
#
# A missing config file is not an error. The server logs the fallback and
# starts on built-in defaults, so this unit works before any config exists.

[Unit]
Description=Fraise in-memory temporal memory graph database for AI agents
Documentation=https://github.com/FraiseHQ/fraise

[Service]
ExecStart=/usr/bin/fraise -config %h/.config/fraise/fraise.config.toml
Restart=on-failure

[Install]
WantedBy=default.target
