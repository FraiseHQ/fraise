FROM golang@sha256:0d1d3a794be25f809dd2cb3160d8c73276c4056a9f8242a138e908ddeee7b6b6 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/fraise ./cmd/server

FROM alpine@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# Run as an unprivileged user rather than root. -D: no password, -H: no home.
RUN adduser -DHu 10001 fraise

COPY --from=build /out/fraise /usr/local/bin/fraise

USER 10001
EXPOSE 9876

ENTRYPOINT ["fraise"]
