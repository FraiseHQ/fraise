# Build stage
FROM golang@sha256:65b6f280bf050ec5af12716857e8ea8439d694dbba8f31ceeb7630670071f2bb AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/fraise ./cmd/server

# Runtime stage
FROM alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

# Run as an unprivileged user rather than root. -D: no password, -H: no home.
RUN adduser -DHu 10001 fraise

COPY --from=build /out/fraise /usr/local/bin/fraise

USER 10001
EXPOSE 9876

ENTRYPOINT ["fraise"]
