{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Maintenance" },
    { "type": "build", "section": "Maintenance" },
    { "type": "ci", "section": "Maintenance" },
    { "type": "chore", "section": "Maintenance" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "fraise",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "bump-minor-pre-major": true,
      "exclude-paths": [
        ".dockerignore",
        ".github",
        ".gitignore",
        ".golangci.yaml",
        ".goreleaser.yaml",
        ".pre-commit-config.yaml",
        ".python-version",
        ".release-please-manifest.json",
        "AGENTS.md",
        "CHANGELOG.md",
        "CLAUDE.md",
        "CODE_OF_CONDUCT.md",
        "COMPATIBILITY.md",
        "CONTRIBUTING.md",
        "Dockerfile.fraise",
        "LICENSE",
        "Makefile",
        "README.md",
        "RELEASE.md",
        "SECURITY.md",
        "assets",
        "codecov.yaml",
        "docker-compose.yaml",
        "docs",
        "examples",
        "pyproject.toml",
        "release-please-config.json",
        "sdk",
        "tests",
        "uv.lock"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "pkg/version/version.go"
        }
      ]
    },
    "sdk/python": {
      "release-type": "python",
      "package-name": "fraise-sdk",
      "component": "python",
      "tag-separator": "/",
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='fraise-sdk')].version"
        }
      ]
    }
  }
}
