# Python SDK integration tests: installs the SDK from source and runs pytest
# against the `fraise` service over the compose network.
#
# The base is a plain minimal Ubuntu, not a python image: uv supplies both the
# interpreter and the resolver, so nothing here needs a preinstalled Python or
# pip. uv itself ships as a static binary, copied from its published image.
FROM ubuntu:24.04

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# ca-certificates is the one thing Ubuntu lacks that uv needs: without it the
# TLS fetch of the standalone interpreter fails.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home

# UV_LINK_MODE=copy: the cache and the venv are on different layers, where
# uv's default hardlinking cannot work. VIRTUAL_ENV + PATH put the venv's
# interpreter first, so the compose command (`python -m pytest`) resolves here.
ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    VIRTUAL_ENV=/home/.venv \
    PATH="/home/.venv/bin:$PATH"

# Interpreter in its own layer so editing the SDK does not re-download it.
RUN uv python install 3.13

# Copying only the SDK first keeps this layer cached across test edits.
COPY sdk/python/ ./
RUN uv sync

COPY tests/integration/python/ ./integration/

# Runner command lives in docker-compose.tests.yaml (python-sdk-integration-tests service).
